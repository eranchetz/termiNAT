  {{dim "💡 Interface endpoints cost $0.01/hour + $0.01/GB data processed"}}
  {{dim "💡 Review unused endpoints to reduce costs"}}
{{end}}
{{- end}}

{{- if .HasTraffic}}
{{header "COLLECTED TRAFFIC SAMPLE"}}
{{dim (printf "Sample period: %d minutes" .Duration)}}

Total Traffic: {{.TrafficStats.TotalRecords}} records, {{printf "%.2f" .TotalTrafficGB}} GB

{{green "Traffic by Service:"}}
  Service        Data         Percentage
  ───────────    ─────────    ──────────
  S3             {{printf "%8.2f GB" .S3GB}}    {{printf "%5.1f%%" .S3Pct}}
  DynamoDB       {{printf "%8.2f GB" .DynamoGB}}    {{printf "%5.1f%%" .DynamoPct}}
  ECR            {{printf "%8.2f GB" .ECRGB}}    {{printf "%5.1f%%" .ECRPct}}
  Other          {{printf "%8.2f GB" .OtherGB}}    {{printf "%5.1f%%" .OtherPct}}

{{- if .TopSourceIPs}}

{{green "Top Source IPs:"}}
{{- range .TopSourceIPs}}
  • {{.IP}}: {{printf "%.2f" .GB}} GB ({{.Records}} records)
{{- end}}
{{- if gt .MoreSources 0}}
  ... and {{.MoreSources}} more sources
{{- end}}
{{end}}
{{- else}}
{{header "TRAFFIC ANALYSIS"}}
{{warn "⚠️  No traffic data collected during the scan period"}}

{{dim "Possible reasons:"}}
  • No applications were actively using the NAT Gateway during collection
  • Flow Logs may not have started delivering data yet (can take 5-10 minutes)
  • All traffic was to private IPs (filtered out by analysis)

{{dim "To diagnose:"}}
  1. Check if applications are running and making outbound requests
  2. Verify Flow Logs are delivering data:
     {{dim (printf "     ./scripts/check-flowlogs-data.sh %s" .LogGroupName)}}
  3. Try running a longer scan (15-30 minutes) during peak usage hours
{{- end}}

{{- if .CostEstimate}}
{{header "COST ESTIMATE"}}
{{warn (printf "⚠️  Projected from %d-minute sample to monthly estimate" .Duration)}}

NAT Gateway Data Processing: ${{printf "%.4f" .CostEstimate.NATGatewayPricePerGB}} per GB

{{green "Projected Monthly Costs:"}}
  NAT Gateway Data Processing Cost:     {{currency .CostEstimate.CurrentMonthlyCost}}/month
