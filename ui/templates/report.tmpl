{{- if .HasInterfaceEndpoints}}
{{green "Interface Endpoints:"}}
{{- range .InterfaceEndpointCosts}}
  • {{.ServiceName}} ({{.DisplayName}}): {{currency .MonthlyCost}}/month
{{- end}}
